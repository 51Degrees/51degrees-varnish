varnishtest "match_all uses query arguments and cookies as well as headers"

server s1 -repeat 20 {
	rxreq
	txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees from "${vmod_topbuild}/src/dd/.libs/libvmod_fiftyonedegrees.so";

	sub vcl_init {
		fiftyonedegrees.start("${vmod_fod_datafile}");
	}
	sub vcl_backend_response {
		set beresp.http.backend-side = fiftyonedegrees.match_all("IsMobile");
	}
	sub vcl_deliver {
		set resp.http.ismobile = fiftyonedegrees.match_all("IsMobile");
		set resp.http.used = fiftyonedegrees.evidence_used();
	}
} -start

client c1 {
	# A header alone.
	txreq -url "/" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0"
	rxresp
	expect resp.http.ismobile == "False"
	# On the backend side there is no client request to take evidence from.
	expect resp.http.backend-side != <undef>
	expect resp.http.used == "{'User-Agent':'Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0'}"

	# A query argument, percent encoded, wins over the header.
	txreq -url "/?User-Agent=Mozilla%2F5.0%20(iPhone%3B%20CPU%20iPhone%20OS%207_1%20like%20Mac%20OS%20X)%20AppleWebKit%2F537.51.2%20(KHTML%2C%20like%20Gecko)%20Version%2F7.0%20Mobile%2F11D167%20Safari%2F9537.53" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0"
	rxresp
	expect resp.http.ismobile == "True"
	expect resp.http.used ~ "'query.User-Agent':'Mozilla/5.0 .iPhone; CPU"

	# The name of the argument in any case, as one of several.
	txreq -url "/?a=b&user-agent=Mozilla%2F5.0%20(iPhone%3B%20CPU%20iPhone%20OS%207_1%20like%20Mac%20OS%20X)%20AppleWebKit%2F537.51.2%20(KHTML%2C%20like%20Gecko)%20Version%2F7.0%20Mobile%2F11D167%20Safari%2F9537.53&c=d" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0"
	rxresp
	expect resp.http.ismobile == "True"

	# The first of two arguments with the same name.
	txreq -url "/?User-Agent=Mozilla%2F5.0%20(iPhone%3B%20CPU%20iPhone%20OS%207_1%20like%20Mac%20OS%20X)%20AppleWebKit%2F537.51.2%20(KHTML%2C%20like%20Gecko)%20Version%2F7.0%20Mobile%2F11D167%20Safari%2F9537.53&User-Agent=other" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0"
	rxresp
	expect resp.http.ismobile == "True"

	# Nothing useful in the query changes nothing.
	txreq -url "/?" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0"
	rxresp
	expect resp.http.ismobile == "False"
	txreq -url "/?User-Agent=" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0"
	rxresp
	expect resp.http.ismobile == "False"
	expect resp.http.used == "{'User-Agent':'Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0'}"
	txreq -url "/?User-Agent" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0"
	rxresp
	expect resp.http.ismobile == "False"

	# A header is only found by its whole name.
	txreq -url "/" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0" -hdr "Sec-CH-UA-Mobile: ?0"
	rxresp
	expect resp.http.used !~ "'Sec-CH-UA':"
	expect resp.http.used ~ "'Sec-CH-UA-Mobile':'.0'"
} -run
