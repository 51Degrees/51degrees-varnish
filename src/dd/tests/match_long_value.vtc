varnishtest "Test a long value followed by another property"

# The matched User-Agent is as long as the User-Agent sent, so the value of
# the property after it is only right if the long value leaves the list of
# property names intact.

server s1 {
       rxreq
       txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees from "${vmod_topbuild}/src/dd/.libs/libvmod_fiftyonedegrees.so";

	sub vcl_deliver {
		set resp.http.all = fiftyonedegrees.match_all(
			"UserAgents,IsMobile");
		set resp.http.single = fiftyonedegrees.match_single(
			req.http.user-agent,
			"UserAgents,IsMobile");
		set resp.http.expected =
			fiftyonedegrees.match_all("UserAgents") + "," +
			fiftyonedegrees.match_all("IsMobile");
	}
	sub vcl_init {
		fiftyonedegrees.start("${vmod_fod_datafile}");
	}

} -start

client c1 {
	txreq -url "/" -hdr "User-Agent: Mozilla/5.0 (iPhone; CPU iPhone OS 7_1 like Mac OS X) AppleWebKit/537.51.2 (KHTML, like Gecko) Version/7.0 Mobile/11D167 Safari/9537.53 Extension/1.0 Extension/1.0 Extension/1.0 Extension/1.0 Extension/1.0 Extension/1.0 Extension/1.0 Extension/1.0 Extension/1.0 Extension/1.0 Extension/1.0 Extension/1.0 Extension/1.0"
	rxresp
	expect resp.status == 200
	expect resp.http.expected ~ "^.{300,},(True|False)$"
	expect resp.http.all == resp.http.expected
	expect resp.http.single == resp.http.expected
}

client c1 -run
