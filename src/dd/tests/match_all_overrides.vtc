varnishtest "A cookie or query argument overrides a property"

# The Lite data file has no JavaScript properties and nothing to override.
feature cmd {case "${vmod_fod_datafile}" in *Lite*) exit 1 ;; esac}

server s1 -repeat 20 {
	rxreq
	txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees from "${vmod_topbuild}/src/dd/.libs/libvmod_fiftyonedegrees.so";

	sub vcl_init {
		fiftyonedegrees.start("${vmod_fod_datafile}");
	}
	sub vcl_deliver {
		set resp.http.width = fiftyonedegrees.match_all("ScreenPixelsWidth");
		set resp.http.used = fiftyonedegrees.evidence_used();
	}
} -start

client c1 {
	# A cookie overrides a property.
	txreq -url "/" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0" -hdr "Cookie: a=b; 51D_ScreenPixelsWidth=1234; c=d"
	rxresp
	expect resp.http.width == "1234"
	expect resp.http.used ~ "'cookie.51D_ScreenPixelsWidth':'1234'"

	# So does a query argument.
	txreq -url "/?51D_ScreenPixelsWidth=4321" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0"
	rxresp
	expect resp.http.width == "4321"
	expect resp.http.used ~ "'query.51D_ScreenPixelsWidth':'4321'"
} -run
