varnishtest "Test properties named in an order other than the order of their names"

# The properties are named in the reverse of the order of their names, so
# each value, and the response header, is only right if a property is read
# by its place among the names given rather than its place in the data
# set's list of properties, which is sorted by name.

server s1 {
       rxreq
       txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees from "${vmod_topbuild}/src/dd/.libs/libvmod_fiftyonedegrees.so";

	sub vcl_deliver {
		set resp.http.browsername = fiftyonedegrees.match_all("BrowserName");
		set resp.http.platformname = fiftyonedegrees.match_all("PlatformName");
		set resp.http.ismobile = fiftyonedegrees.match_all("IsMobile");
		set resp.http.allproperties = fiftyonedegrees.match_all("BrowserName,IsMobile,PlatformName");
		fiftyonedegrees.set_resp_headers();
	}
	sub vcl_init {
		fiftyonedegrees.set_properties("SetHeaderBrowserAccept-CH,PlatformName,IsMobile,BrowserName");
		fiftyonedegrees.start("${vmod_fod_datafile}");
	}

} -start

client c1 {
	txreq -url "/" -hdr "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/89.0.4389.114 Safari/537.36"
	rxresp
	expect resp.http.browsername == "Chrome"
	expect resp.http.platformname == "Windows"
	expect resp.http.ismobile == "False"
	expect resp.http.allproperties == "Chrome,False,Windows"
	expect resp.http.accept-ch ~ "Sec-CH-UA"
}

client c1 -run
