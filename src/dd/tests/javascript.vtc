varnishtest "The JavaScript functions, for serving a property's script to a browser"

# The Lite data file has no JavaScript properties and nothing to override.
feature cmd {case "${vmod_fod_datafile}" in *Lite*) exit 1 ;; esac}

server s1 -repeat 20 {
	rxreq
	txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees from "${vmod_topbuild}/src/dd/.libs/libvmod_fiftyonedegrees.so";

	sub vcl_init {
		fiftyonedegrees.start("${vmod_fod_datafile}");
	}
	sub vcl_recv {
		return (synth(200));
	}
	sub vcl_synth {
		set resp.http.Content-Type = "application/x-javascript";
		if (req.url == "/all.js") {
			set resp.body = fiftyonedegrees.get_javascript_all("ScreenPixelsWidthJavascript");
		}
		else if (req.url == "/single.js") {
			set resp.body = fiftyonedegrees.get_javascript_single(req.http.user-agent, "ScreenPixelsWidthJavascript");
		}
		else if (req.url == "/no-agent.js") {
			set resp.body = fiftyonedegrees.get_javascript_single(req.http.not-sent, "ScreenPixelsWidthJavascript");
		}
		else if (req.url == "/not-a-property.js") {
			set resp.body = fiftyonedegrees.get_javascript_single(req.http.user-agent, "thisisnotarealpropertyname");
		}
		return (deliver);
	}
} -start

client c1 {
	txreq -url "/all.js" -hdr "User-Agent: Mozilla/5.0 (iPhone; CPU iPhone OS 7_1 like Mac OS X) AppleWebKit/537.51.2 (KHTML, like Gecko) Version/7.0 Mobile/11D167 Safari/9537.53"
	rxresp
	expect resp.status == 200
	expect resp.http.Content-Type == "application/x-javascript"
	expect resp.body ~ "51D_ScreenPixelsWidth"

	txreq -url "/single.js" -hdr "User-Agent: Mozilla/5.0 (iPhone; CPU iPhone OS 7_1 like Mac OS X) AppleWebKit/537.51.2 (KHTML, like Gecko) Version/7.0 Mobile/11D167 Safari/9537.53"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "51D_ScreenPixelsWidth"

	txreq -url "/no-agent.js"
	rxresp
	expect resp.status == 200

	txreq -url "/not-a-property.js" -hdr "User-Agent: Mozilla/5.0 (iPhone; CPU iPhone OS 7_1 like Mac OS X) AppleWebKit/537.51.2 (KHTML, like Gecko) Version/7.0 Mobile/11D167 Safari/9537.53"
	rxresp
	expect resp.status == 200
	expect resp.body == "/* 51Degrees Javascript not available. */"
} -run

${vcache} v1 -cliexpect "Child has not panicked" "panic.show"
