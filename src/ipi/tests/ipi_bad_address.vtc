varnishtest "A missing or malformed address gives N/A and the request carries on"

server s1 -repeat 20 {
	rxreq
	txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";

	sub vcl_init {
		fiftyonedegrees_ipi.start("${vmod_ipi_datafile}");
	}
	sub vcl_deliver {
		set resp.http.absent = fiftyonedegrees_ipi.match("AsnName,Asn", req.http.not-sent);
		set resp.http.empty = fiftyonedegrees_ipi.match("AsnName", "");
		set resp.http.malformed = fiftyonedegrees_ipi.match("AsnName", "not an address");
		set resp.http.too-many = fiftyonedegrees_ipi.match("AsnName", "1.2.3.4.5");
		set resp.http.list-first = fiftyonedegrees_ipi.match("AsnName", "212.58.224.22, 2.248.13.139");
	}
} -start

logexpect l1 -v v1 -g raw -q "VCL_Error" {
	expect * * VCL_Error "No IP address to look up"
} -start

client c1 {
	txreq
	rxresp
	expect resp.status == 200
	expect resp.http.absent == "N/A,N/A"
	expect resp.http.empty == "N/A"
	expect resp.http.malformed == "N/A"
	expect resp.http.too-many == "N/A"
	expect resp.http.list-first == {\"BBC\":1}
} -run

logexpect l1 -wait
