varnishtest "Values follow the order and delimiter asked for, and missing ones are N/A"

server s1 -repeat 20 {
	rxreq
	txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";

	sub vcl_init {
		fiftyonedegrees_ipi.set_properties("AsnName");
		fiftyonedegrees_ipi.set_delimiter(";");
		fiftyonedegrees_ipi.start("${vmod_ipi_datafile}");
		# Too late, so this has no effect.
		fiftyonedegrees_ipi.set_delimiter("!");
	}
	sub vcl_deliver {
		set resp.http.one = fiftyonedegrees_ipi.match("AsnName", "212.58.224.22");
		set resp.http.not-loaded = fiftyonedegrees_ipi.match("Asn", "212.58.224.22");
		set resp.http.several = fiftyonedegrees_ipi.match("AsnName,Asn,AsnName", "212.58.224.22");
		set resp.http.gaps = fiftyonedegrees_ipi.match("AsnName,,invalid", "212.58.224.22");
		set resp.http.empty = fiftyonedegrees_ipi.match("", "212.58.224.22");
	}
} -start

client c1 {
	txreq
	rxresp
	expect resp.status == 200
	expect resp.http.one == {\"BBC\":1}
	expect resp.http.not-loaded == "N/A"
	expect resp.http.several == {\"BBC\":1;N/A;\"BBC\":1}
	expect resp.http.gaps == {\"BBC\":1;N/A;N/A}
	expect resp.http.empty == ""
} -run
