varnishtest "Values which do not fit in the workspace are never cut short"

server s1 -repeat 20 {
	rxreq
	txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";

	sub vcl_init {
		fiftyonedegrees_ipi.start("${vmod_ipi_datafile}");
	}
	sub vcl_recv {
		set req.http.p16 = "AsnName,AsnName,AsnName,AsnName,AsnName,AsnName,AsnName,AsnName,AsnName,AsnName,AsnName,AsnName,AsnName,AsnName,AsnName,AsnName";
		set req.http.p64 = req.http.p16 + "," + req.http.p16 + "," + req.http.p16 + "," + req.http.p16;
		set req.http.p256 = req.http.p64 + "," + req.http.p64 + "," + req.http.p64 + "," + req.http.p64;
		set req.http.p1024 = req.http.p256 + "," + req.http.p256 + "," + req.http.p256 + "," + req.http.p256;
		set req.http.p4096 = req.http.p1024 + "," + req.http.p1024 + "," + req.http.p1024 + "," + req.http.p1024;
	}
	sub vcl_deliver {
		set resp.http.fits = fiftyonedegrees_ipi.match(req.http.p64, "212.58.224.22");
		set resp.http.too-long = fiftyonedegrees_ipi.match(req.http.p4096, "212.58.224.22");
		set resp.http.after = fiftyonedegrees_ipi.match("AsnName", "212.58.224.22");
	}
} -start

client c1 {
	txreq
	rxresp
	expect resp.status == 200
	expect resp.http.fits ~ {^(\\"BBC\\":1,){63}\\"BBC\\":1$}
	expect resp.http.too-long !~ "BBC"
	expect resp.http.after == {\"BBC\":1}
} -run
