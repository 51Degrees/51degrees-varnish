varnishtest "Both modules in one VCL each use their own copy of the common code"

server s1 -repeat 20 {
	rxreq
	txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees from "${vmod_topbuild}/src/dd/.libs/libvmod_fiftyonedegrees.so";
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";

	sub vcl_init {
		fiftyonedegrees.start("${vmod_fod_datafile}");
		fiftyonedegrees_ipi.start("${vmod_ipi_datafile}");
	}
	sub vcl_deliver {
		set resp.http.browser = fiftyonedegrees.match_all("BrowserName");
		set resp.http.asn = fiftyonedegrees_ipi.match("AsnName,Asn", "212.58.224.22");
		set resp.http.dd-name = fiftyonedegrees.get_dataset_name();
		set resp.http.ipi-name = fiftyonedegrees_ipi.get_dataset_name();
		fiftyonedegrees.reload();
		fiftyonedegrees_ipi.reload();
		set resp.http.browser-after = fiftyonedegrees.match_all("BrowserName");
		set resp.http.asn-after = fiftyonedegrees_ipi.match("AsnName,Asn", "212.58.224.22");
	}
} -start

client c1 {
	txreq -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0"
	rxresp
	expect resp.status == 200
	expect resp.http.browser == "Firefox"
	expect resp.http.browser-after == "Firefox"
	expect resp.http.asn == {\"BBC\":1,\"AS2818\":1}
	expect resp.http.asn-after == {\"BBC\":1,\"AS2818\":1}
	expect resp.http.ipi-name == "IPIV4Asn"
	expect resp.http.dd-name != ""
	expect resp.http.dd-name != resp.http.ipi-name
} -run
