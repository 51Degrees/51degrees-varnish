varnishtest "The DEFAULT performance profile gives the same answers"

server s1 -repeat 20 {
	rxreq
	txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";

	sub vcl_init {
		fiftyonedegrees_ipi.set_performance_profile("DEFAULT");
		fiftyonedegrees_ipi.set_max_concurrency(10);
		fiftyonedegrees_ipi.start("${vmod_ipi_datafile}");
	}
	sub vcl_deliver {
		set resp.http.asn = fiftyonedegrees_ipi.match("AsnName,Asn", "212.58.224.22");
	}
} -start

client c1 {
	txreq
	rxresp
	expect resp.status == 200
	expect resp.http.asn == {\"BBC\":1,\"AS2818\":1}
} -run
