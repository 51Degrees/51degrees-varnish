varnishtest "Each VCL has its own data, so one can be discarded whilst another runs"

server s1 -repeat 20 {
	rxreq
	txresp
} -start

${vcache} v1 -vcl+backend {
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";
	sub vcl_init {
		fiftyonedegrees_ipi.start("${vmod_ipi_datafile}");
	}
	sub vcl_deliver {
		set resp.http.asn = fiftyonedegrees_ipi.match("AsnName", "212.58.224.22");
		set resp.http.vcl = "first";
	}
} -start

client c1 {
	txreq
	rxresp
	expect resp.http.vcl == "first"
	expect resp.http.asn == {\"BBC\":1}
} -run

${vcache} v1 -vcl+backend {
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";
	sub vcl_init {
		fiftyonedegrees_ipi.set_delimiter(";");
		fiftyonedegrees_ipi.start("${vmod_ipi_datafile}");
	}
	sub vcl_deliver {
		set resp.http.asn = fiftyonedegrees_ipi.match("AsnName,Asn", "212.58.224.22");
		set resp.http.vcl = "second";
	}
}

${vcache} v1 -cliok "vcl.state vcl1 cold"
${vcache} v1 -cliok "vcl.discard vcl1"

client c2 {
	txreq
	rxresp
	expect resp.http.vcl == "second"
	expect resp.http.asn == {\"BBC\":1;\"AS2818\":1}
} -run

${vcache} v1 -cliexpect "Child has not panicked" "panic.show"
