varnishtest "A data file which cannot be used stops the VCL loading and nothing else"

server s1 -repeat 20 {
	rxreq
	txresp
} -start

# A copy of the data file which says it is version 4.5. The version is held in
# the first two 32 bit numbers of the file.
shell {
	f="${vmod_ipi_datafile}"
	{ head -c 4 "$f"; printf '\005\000\000\000'; tail -c +9 "$f"; } > "${tmpdir}/old.ipi"
}

${vcache} v1 -vcl+backend {} -start

${vcache} v1 -errvcl "could not be found" {
	backend default { .host = "${s1_addr}"; .port = "${s1_port}"; }
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";
	sub vcl_init {
		fiftyonedegrees_ipi.start("${tmpdir}/not-a-file.ipi");
	}
}

${vcache} v1 -errvcl "unsupported version" {
	backend default { .host = "${s1_addr}"; .port = "${s1_port}"; }
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";
	sub vcl_init {
		fiftyonedegrees_ipi.start("${tmpdir}/old.ipi");
	}
}

${vcache} v1 -errvcl "start needs the path" {
	backend default { .host = "${s1_addr}"; .port = "${s1_port}"; }
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";
	sub vcl_init {
		fiftyonedegrees_ipi.start("");
	}
}

# Varnish is still running, and a good file loads.
${vcache} v1 -vcl+backend {
	import fiftyonedegrees_ipi from "${vmod_topbuild}/src/ipi/.libs/libvmod_fiftyonedegrees_ipi.so";
	sub vcl_init {
		fiftyonedegrees_ipi.start("${vmod_ipi_datafile}");
	}
	sub vcl_deliver {
		set resp.http.asn = fiftyonedegrees_ipi.match("AsnName", "212.58.224.22");
	}
}

client c1 {
	txreq
	rxresp
	expect resp.status == 200
	expect resp.http.asn == {\"BBC\":1}
} -run

${vcache} v1 -cliexpect "Child has not panicked" "panic.show"
