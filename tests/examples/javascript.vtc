varnishtest "The JavaScript example"

# The Lite data file has no JavaScript properties and nothing to override.
feature cmd {case "${vmod_fod_datafile}" in *Lite*) exit 1 ;; esac}

server s1 -repeat 20 {
	rxreq
	txresp
} -start

shell {
	sed -e 's#/etc/varnish/51Degrees-LiteV4.1.hash#${vmod_fod_datafile}#' \
		-e 's#/etc/varnish/51Degrees-Enterprise-HashV41.hash#${vmod_fod_datafile}#' \
		-e 's#/etc/varnish/51Degrees-IPIV4AsnIpiV41.ipi#${vmod_ipi_datafile}#' \
		-e 's#/app/cxx/device-detection-data/51Degrees-LiteV4.1.hash#${vmod_fod_datafile}#' \
		-e 's#/app/cxx/ip-intelligence-data/51Degrees-IPIV4AsnIpiV41.ipi#${vmod_ipi_datafile}#' \
		-e 's#\.host = "127.0.0.1"#.host = "${s1_addr}"#' \
		-e 's#\.port = "80"#.port = "${s1_port}"#' \
		"${vmod_topsrc}/examples/hash/jsExample/javascript.vcl" > "${tmpdir}/example.vcl"
}

${vcache} v1 -arg "-p vmod_path=${vmod_topbuild}/src/dd/.libs:${vmod_topbuild}/src/ipi/.libs" -vcl+backend {} -start
${vcache} v1 -cliok "vcl.load example ${tmpdir}/example.vcl"
${vcache} v1 -cliok "vcl.use example"

client c1 {
	txreq -url "/51D.js" -hdr "User-Agent: Mozilla/5.0 (iPhone; CPU iPhone OS 7_1 like Mac OS X) AppleWebKit/537.51.2 (KHTML, like Gecko) Version/7.0 Mobile/11D167 Safari/9537.53"
	rxresp
	expect resp.status == 200
	expect resp.http.Content-Type == "application/x-javascript"
	expect resp.body ~ "51D_ScreenPixelsWidth"
	txreq -url "/overrides" -hdr "Cookie: 51D_ScreenPixelsWidth=1234" -hdr "User-Agent: Mozilla/5.0 (Windows NT 6.3; WOW64; rv:41.0) Gecko/20100101 Firefox/41.0"
	rxresp
	expect resp.status == 200
	expect resp.http.x-screenpixelswidth == "1234"
	expect resp.http.Access-Control-Allow-Origin == "*"
} -run

${vcache} v1 -cliexpect "Child has not panicked" "panic.show"
