varnishtest "The configuration example"

server s1 -repeat 20 {
	rxreq
	txresp
} -start

shell {
	sed -e 's#/etc/varnish/51Degrees-LiteV4.1.hash#${vmod_fod_datafile}#' 		-e 's#/etc/varnish/51Degrees-Enterprise-HashV41.hash#${vmod_fod_datafile}#' 		-e 's#/etc/varnish/51Degrees-IPIV4AsnIpiV41.ipi#${vmod_ipi_datafile}#' 		-e 's#/app/cxx/data/device-detection/51Degrees-LiteV4.1.hash#${vmod_fod_datafile}#' 		-e 's#/app/cxx/data/ip-intelligence/51Degrees-IPIV4AsnIpiV41.ipi#${vmod_ipi_datafile}#' 		-e 's#\.host = "127.0.0.1"#.host = "${s1_addr}"#' 		-e 's#\.port = "80"#.port = "${s1_port}"#' 		"${vmod_topsrc}/examples/hash/config.vcl" > "${tmpdir}/example.vcl"
}

${vcache} v1 -arg "-p vmod_path=${vmod_topbuild}/src/dd/.libs:${vmod_topbuild}/src/ipi/.libs" -vcl+backend {} -start
${vcache} v1 -cliok "vcl.load example ${tmpdir}/example.vcl"
${vcache} v1 -cliok "vcl.use example"

# The example joins the values with ":", turns the performance graph off and
# the predictive graph on, so a desktop browser reads IsMobile False, then the
# match metrics, with the PREDICTIVE method, and the profile ids last.
client c1 {
	txreq -hdr "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/78.0.3904.97 Safari/537.36"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Metadata ~ "^False:[0-9]+:[0-9]+:[0-9]+:PREDICTIVE:"
	expect resp.http.X-Metadata ~ ":[0-9]+-[0-9]+-[0-9]+-[0-9]+$"
} -run

${vcache} v1 -cliexpect "Child has not panicked" "panic.show"
